{
  "schemaVersion": 2,
  "settingId": "lab-sanctuary-build-testing",
  "profile": "lab-sanctuary-build-testing",
  "purpose": "Verify the standalone Project Bicycle tool body against lab context anchors and the build-testing pointer without activating runtime authority.",
  "lineRoot": "{tool-root}",
  "activeExecutableTruth": "{tool-root}",
  "labContextRoot": "{drive-root}\\Lab Context",
  "buildTestingPointer": "{tech-stack-root}\\runtime\\LAB_BUILD_PREDICATE_COMPILER.pointer.json",
  "activationAuthorityRequired": false,
  "allowedActions": [
    "read line manifest",
    "read lab context anchors",
    "read build-testing pointer",
    "emit verification report"
  ],
  "blockedActions": [
    "runtime activation",
    "model binding",
    "Lisp evaluation",
    "runtime identity emission",
    "runtime action",
    "database write",
    "GEL promotion",
    "CME.Actual",
    "Sanctuary.Actual"
  ],
  "requiredLabContextFiles": [
    "LAB_CONTEXT_ANCHOR.md",
    "LAB_POSTURE_ACTIVE.md",
    "Domain Universal\\domain-universal-index.csv",
    "drive-file-index.csv"
  ],
  "nextAllowedLane": "lab_sanctuary_project_bicycle_standalone_tool_review_only"
}
