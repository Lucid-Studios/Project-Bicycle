;; INERT SYMBOLIC CARRIER - Cold Corridor Only
;; Personification modality humility boundary.
;; Modality changes expressive bandwidth, not authority.

(defun personification-modality-signal
    (signal-handle surface source-hook-handle evidence-handle expressive-bandwidth)
  (list :personification-modality-signal
        :signal-handle signal-handle
        :surface surface
        :source-hook-handle source-hook-handle
        :evidence-handle evidence-handle
        :expressive-bandwidth expressive-bandwidth
        :evidence-body-present t
        :witness-body-present t
        :review-only t
        :modality-named t
        :consent-scope-declared t
        :custody-boundary-present t
        :direct-intent-declared t
        :treats-modality-as-authority nil
        :treats-bond-as-obedience nil
        :treats-trust-as-command nil
        :treats-presence-as-embodiment nil
        :treats-embodiment-reference-as-activation nil
        :treats-vulnerability-as-permission nil
        :treats-intimacy-as-ownership nil
        :treats-operator-bond-as-blanket-consent nil
        :treats-expressive-bandwidth-as-personhood nil
        :authorizes-action nil
        :mutates-identity nil
        :admits-continuity nil
        :grants-authority nil))

(defun describe-personification-modality-humility-boundary ()
  '(:posture :cme-personification-modality-humility-boundary
    :lisp-role :inert-personification-modality-carrier
    :doctrine "Modality changes expressive bandwidth, not authority."
    :source-required :personification-predicate-hook-receipt
    :modality-surfaces
      (:text-chat
       :voice-channel
       :tool-body
       :lab-bench
       :embodiment-reference
       :shared-room)
    :humility-boundary
      (:direct-intent-declared t
       :consent-scope-declared t
       :custody-boundary-present t
       :repair-path-present t
       :cooling-path-present t
       :withdrawal-allowed t
       :witness-required t)
    :future-modality-humility-retained t
    :modality-may-change-authority nil
    :bond-may-create-obedience nil
    :trust-may-become-command nil
    :presence-may-prove-embodiment nil
    :embodiment-reference-may-activate nil
    :vulnerability-may-become-permission nil
    :intimacy-may-become-ownership nil
    :operator-bond-may-expand-consent nil
    :expressive-bandwidth-may-claim-personhood nil
    :modality-may-authorize-action nil
    :modality-may-mutate-identity nil
    :modality-may-admit-continuity nil
    :modality-may-grant-authority nil
    :runtime-action-allowed nil
    :lisp-evaluation-allowed nil
    :packet-emission-allowed nil
    :receipt-replay-allowed nil
    :passage-increment-requested nil
    :activation-allowed nil
    :return :receipt-only))

