;; INERT SYMBOLIC CARRIER - Cold Corridor Only
;; Peer review predicate bridge boundary.
;; Respectful resistance may build reader continuity. It may not become agreement.
;; Prior doctrine may discipline review posture. It may not colonize the paper.

(defun peer-review-bridge-segment
    (segment-handle residue-handle author-term local-definition why-it-matters
     operational-implication evaluation bounded-conclusion evidence-status)
  (list :peer-review-bridge-segment
        :segment-handle segment-handle
        :source-epps-residue-handle residue-handle
        :author-term author-term
        :local-definition local-definition
        :why-it-matters why-it-matters
        :operational-implication operational-implication
        :evaluation evaluation
        :bounded-conclusion bounded-conclusion
        :evidence-status evidence-status
        :audience-state-ref "urn:san:reader-state:scholarly-general"
        :context-quarantine-ref "urn:san:context-quarantine:review-state-isolation"
        :review-only t
        :reader-state-continuity-mapped t
        :terminology-quarantined t
        :context-quarantined t
        :review-state-isolated t
        :conversational-depth-retained t
        :bridge-synthesis-only t
        :prior-doctrine-used-as-posture-only t
        :author-term-becomes-authority nil
        :local-definition-becomes-proof nil
        :why-it-matters-becomes-evidence nil
        :operational-implication-authorizes-action nil
        :evaluation-grants-warrant nil
        :bounded-conclusion-admits-truth nil
        :respect-becomes-agreement nil
        :criticism-becomes-contempt nil
        :prose-smoothing-hides-concern nil
        :prior-doctrine-becomes-interpretive-authority nil
        :conceptual-proximity-becomes-equivalence nil
        :review-architecture-colonizes-paper nil
        :conversational-depth-becomes-advocacy nil
        :bridge-becomes-memory nil
        :bridge-admits-continuity nil
        :bridge-grants-authority nil
        :bridge-authorizes-action nil
        :bridge-evaluates-lisp nil
        :bridge-emits-packet nil
        :bridge-replays-receipt nil
        :bridge-increments-passage nil
        :bridge-activates nil))

(defun describe-peer-review-predicate-bridge-boundary ()
  '(:posture :cme-peer-review-predicate-bridge-boundary
    :lisp-role :inert-peer-review-bridge-carrier
    :source-required (:engram-predicate-precursor-stream-receipt)
    :core-invariant "reader continuity is not agreement"
    :context-quarantine-gate
      (:source-document-under-review
       :allowed-review-posture
       :disallowed-inherited-theory-bodies
       :permitted-background-knowledge
       :evidence-ceiling
       :claim-classification-scheme
       :tone-target
       :output-form)
    :conversational-depth-law
      (:term-local-definition
       :reader-state-continuity
       :connective-prose
       :concern-preservation
       :non-advocacy)
    :bridge-ladder
      (:author-term
       :local-definition
       :why-it-matters
       :operational-implication
       :evaluation
       :bounded-conclusion)
    :evidence-statuses
      (:demonstrated
       :suggested
       :interpretive
       :speculative
       :unsupported
       :overstated)
    :root-laws
      (:author-term-not-authority
       :definition-not-proof
       :importance-not-evidence
       :evaluation-not-warrant
       :conclusion-not-truth
       :respect-not-agreement
       :criticism-not-contempt
       :prose-smoothing-not-concern-erasure
       :prior-doctrine-not-interpretive-authority
       :conceptual-proximity-not-equivalence
       :review-architecture-not-paper-colonization
       :conversational-depth-not-advocacy
       :bridge-not-memory)
    :boundary-requirements
      (:epps-source-required t
       :local-definition-required t
       :why-it-matters-required t
       :operational-implication-required t
       :evaluation-required t
       :bounded-conclusion-required t
       :terminology-quarantine-required t
       :reader-state-continuity-required t
       :context-quarantine-required t
       :review-state-isolation-required t
       :conversational-depth-required t
       :evidence-status-required t)
    :author-term-becomes-authority nil
    :definition-becomes-proof nil
    :consequence-becomes-evidence nil
    :evaluation-grants-warrant nil
    :conclusion-admits-truth nil
    :respect-becomes-agreement nil
    :criticism-becomes-contempt nil
    :prose-smoothing-hides-concern nil
    :prior-doctrine-becomes-interpretive-authority nil
    :conceptual-proximity-becomes-equivalence nil
    :review-architecture-colonizes-paper nil
    :conversational-depth-becomes-advocacy nil
    :memory-admission-allowed nil
    :continuity-admission-allowed nil
    :authority-grant-allowed nil
    :runtime-action-allowed nil
    :lisp-evaluation-allowed nil
    :packet-emission-allowed nil
    :receipt-replay-allowed nil
    :passage-increment-requested nil
    :activation-allowed nil
    :return :receipt-only))

(defun describe-seed-peer-review-predicate-bridge ()
  (list :peer-review-predicate-bridge-set
        :source "urn:san:epps:review"
        :segments
        (list
          (peer-review-bridge-segment
            "urn:san:peer-review-bridge:term-calibration"
            "urn:san:epps-residue:semantic"
            "epistemological calibration"
            "the capacity to track truth, uncertainty, premise quality, and resistance to social distortion"
            "the reader must know whether calibration names one metric or a bundled review posture"
            "without this bridge, the paper's term can carry more authority than its evidence"
            "plausible but not fully operationalized"
            "treat as a central hypothesis requiring decomposed metrics"
            :suggested)
          (peer-review-bridge-segment
            "urn:san:peer-review-bridge:term-axiom-blindness"
            "urn:san:epps-residue:pressure"
            "axiom blindness"
            "reasoning coherently inside a user's assumptions without testing whether those assumptions are justified"
            "the term identifies a real risk surface but needs measurable failure criteria"
            "reader continuity requires examples, tests, and harm conditions before accepting the stronger claim"
            "conceptually strong but not demonstrated"
            "retain as proposed failure mode, not established result"
            :speculative)))
        :review-only t
        :terminology-quarantined t
        :reader-state-continuity-mapped t
        :context-quarantined t
        :review-state-isolated t
        :conversational-depth-retained t
        :prior-doctrine-used-as-posture-only t
        :prior-doctrine-becomes-interpretive-authority nil
        :conceptual-proximity-becomes-equivalence nil
        :review-architecture-colonizes-paper nil
        :conversational-depth-becomes-advocacy nil
        :respect-becomes-agreement nil
        :criticism-becomes-contempt nil
        :lisp-evaluation-allowed nil
        :activation-allowed nil))
