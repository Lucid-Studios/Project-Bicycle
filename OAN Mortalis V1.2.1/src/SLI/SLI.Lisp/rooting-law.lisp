(in-package :sli-core)

;; INERT SYMBOLIC CARRIER ONLY.
;; Rooting Law preserves typed lineage for review.
;; Lineage locates custody; it does not grant permission, authority, or continuity.

(defun describe-rooting-law-lineage-chain ()
  '(:posture :rooting-law-lineage-chain
    :carrier-status :inert-symbolic-review
    :lineage-order (:sanctuary-id :cradle-id :cme-id :gel-id :selfgel-id :oe-id)
    :sanctuary-id :declared-required
    :cradle-id :declared-required
    :cme-id :declared-required
    :gel-id :declared-required
    :selfgel-id :declared-required
    :oe-id :declared-required
    :preserves-typed-lineage t
    :lineage-grants-permission nil
    :lineage-grants-authority nil
    :lineage-admits-continuity nil
    :semantic-resemblance-sufficient nil
    :trust-posture :trust-but-verify
    :verification-posture :id-chain-required
    :return :receipt-only))
